{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opsman interview questions",
  "type": "object",
  "required": ["schema_version", "questions"],
  "properties": {
    "schema_version": { "type": "string" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "question", "why_it_matters"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "default": { "type": "string" },
          "answer": { "type": ["string", "null"] },
          "answered_by": { "enum": ["human", "agent", null] }
        }
      }
    }
  }
}
