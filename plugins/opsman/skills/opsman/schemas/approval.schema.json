{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opsman approval payload",
  "type": "object",
  "required": ["kind", "approver", "approved_at"],
  "properties": {
    "kind": { "enum": ["command", "continuation"] },
    "step_id": { "type": "string" },
    "command": { "type": "string" },
    "effective_risk": { "type": "string" },
    "approver": { "type": "string" },
    "approved_at": { "type": "string" },
    "note": { "type": "string" }
  }
}
