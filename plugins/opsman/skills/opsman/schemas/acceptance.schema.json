{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opsman acceptance checks (schema_check enforces required keys; deeper rules are enforced by the record gates)",
  "type": "object",
  "required": ["checks"],
  "properties": {
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "command", "expected_exit"],
        "properties": {
          "id": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "expected_exit": {
            "type": "integer"
          },
          "risk": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "expected_output_pattern": {
            "type": "string"
          }
        }
      }
    }
  }
}
