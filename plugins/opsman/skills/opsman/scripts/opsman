#!/bin/sh
# opsman kernel: the single agent-facing entry point for run orchestration.
set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/common.sh"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/log.sh"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/paths.sh"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/state.sh"

usage() {
  cat >&2 <<'EOF'
usage: opsman <verb> [args]

verbs:
  start [--global] [--limit key=value ...] [--] "<task>"
                    build the skill registry and initialize a run
  next              render the context packet for the role owning the current state
  worktree [<run-id>]
                    create or verify the isolated run worktree
  run-step <step-id>
                    execute one command-backed plan step
  status            print the current run's STATE.md
  record --event <Event> [--payload <file.json>]
                    record an event for the current run (the only mutator)
  map [--global]    rebuild the skill registry (--global adds home-level skill roots)
  validate          run acceptance checks and capture evidence
  validate-run [<run-id>]
                    check run artifacts for consistency
  judge             validate artifacts, then render the oracle packet (JUDGING only)
  resume [<run-id>]
                    rebuild state from the journal, validate, and reattach
  clean [--yes]     list (default) or delete finished runs and orphan worktrees
  history [--json] [--limit <n>] [<run-id>]
                    list finished runs recorded in the cross-run ledger
  deliver [<run-id>] [--branch <name>]
                    land a COMPLETED run: branch + commit from final.patch, pr-body.md
  board [--port <n>]
                    serve a read-only local hub for humans (default port 41999)
EOF
}

current_run() {
  [ -f "$OPSMAN_CURRENT_FILE" ] || die "$EX_USAGE" "no active run (start one with: opsman start \"<task>\")"
  cat "$OPSMAN_CURRENT_FILE"
}

verb=${1:-}
if [ -z "$verb" ]; then
  usage
  exit "$EX_USAGE"
fi
shift

case $verb in
  start)
    if [ "${1:-}" = "--global" ]; then
      OPSMAN_INCLUDE_GLOBAL=1
      export OPSMAN_INCLUDE_GLOBAL
      shift
    fi
    if [ $# -lt 1 ]; then
      die "$EX_USAGE" "start needs a task argument — quote it: opsman start [--global] [--limit key=value] \"<task>\""
    fi
    need_cmd jq
    need_cmd git
    "$SCRIPT_DIR/build-registry.sh"
    "$SCRIPT_DIR/init-run.sh" "$@"
    ;;
  next)
    need_cmd jq
    # Assignment form: current_run's die must abort the verb, and a command
    # substitution in argument position would swallow it.
    run=$(current_run)
    run_dir=$OPSMAN_RUNS_DIR/$run
    # Reconcile a crash-torn state before deciding which role acts: the
    # journal wins, same rule the mutator applies.
    "$SCRIPT_DIR/acquire-lock.sh"
    trap '"$SCRIPT_DIR/release-lock.sh"' EXIT
    sync_state_with_log "$run_dir"
    render_packet_for_current_state "$SCRIPT_DIR" "$run" "$run_dir"
    ;;
  worktree)
    run=${1:-$(current_run)}
    "$SCRIPT_DIR/create-worktree.sh" --run "$run"
    ;;
  run-step)
    [ $# -eq 1 ] || die "$EX_USAGE" "run-step takes exactly one step id"
    run=$(current_run)
    "$SCRIPT_DIR/run-step.sh" --run "$run" "$1"
    ;;
  status)
    run=$(current_run)
    cat "$OPSMAN_RUNS_DIR/$run/STATE.md"
    ;;
  record)
    run=$(current_run)
    "$SCRIPT_DIR/record-event.sh" --run "$run" "$@"
    ;;
  map)
    if [ "${1:-}" = "--global" ]; then
      OPSMAN_INCLUDE_GLOBAL=1
      export OPSMAN_INCLUDE_GLOBAL
      shift
    fi
    # Refuse leftovers: a misspelled --global must fail loudly, not rebuild
    # a repo-only registry the caller believes includes global skills.
    [ $# -eq 0 ] || die "$EX_USAGE" "map takes no arguments besides --global (got: $*)"
    "$SCRIPT_DIR/build-registry.sh"
    ;;
  validate-run)
    run=${1:-$(current_run)}
    "$SCRIPT_DIR/validate-artifacts.sh" "$OPSMAN_RUNS_DIR/$run"
    ;;
  validate)
    run=$(current_run)
    "$SCRIPT_DIR/run-tests.sh" --run "$run"
    ;;
  judge)
    need_cmd jq
    run=$(current_run)
    run_dir=$OPSMAN_RUNS_DIR/$run
    # Reconcile a crash-torn state before judging: the journal wins, same
    # rule next applies.
    "$SCRIPT_DIR/acquire-lock.sh"
    trap '"$SCRIPT_DIR/release-lock.sh"' EXIT
    sync_state_with_log "$run_dir"
    state=$(current_status "$run_dir")
    [ "$state" = "JUDGING" ] \
      || die "$EX_STATE" "run $run is in $state; judge requires JUDGING"
    "$SCRIPT_DIR/validate-artifacts.sh" "$run_dir"
    "$SCRIPT_DIR/render-context.sh" --run "$run"
    ;;
  resume)
    # resume.sh owns the whole flow (repair, validate, repoint, handoff,
    # packet render) inside one lock cycle, so exit 0 always means resumed.
    "$SCRIPT_DIR/resume.sh" "$@"
    ;;
  clean)
    "$SCRIPT_DIR/clean.sh" "$@"
    ;;
  history)
    "$SCRIPT_DIR/history.sh" "$@"
    ;;
  deliver)
    "$SCRIPT_DIR/deliver.sh" "$@"
    ;;
  board)
    "$SCRIPT_DIR/board.sh" "$@"
    ;;
  -h | --help)
    usage
    ;;
  *)
    usage
    exit "$EX_USAGE"
    ;;
esac
