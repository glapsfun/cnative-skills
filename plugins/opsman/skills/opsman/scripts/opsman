#!/bin/sh
# opsman kernel: the single agent-facing entry point for run orchestration.
set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/common.sh"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/log.sh"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/paths.sh"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/state.sh"

usage() {
  cat >&2 <<'EOF'
usage: opsman <verb> [args]

verbs:
  start "<task>"    build the skill registry and initialize a run
  next              render the context packet for the role owning the current state
  status            print the current run's STATE.md
  record --event <Event> [--payload <file.json>]
                    record an event for the current run (the only mutator)
  map               rebuild the skill registry
  validate-run [<run-id>]
                    check run artifacts for consistency

Verbs validate, judge, resume, clean arrive in later milestones.
EOF
}

current_run() {
  [ -f "$OPSMAN_CURRENT_FILE" ] || die "$EX_USAGE" "no active run (start one with: opsman start \"<task>\")"
  cat "$OPSMAN_CURRENT_FILE"
}

verb=${1:-}
if [ -z "$verb" ]; then
  usage
  exit "$EX_USAGE"
fi
shift

case $verb in
  start)
    if [ $# -ne 1 ] || [ -z "$1" ]; then
      die "$EX_USAGE" "start takes exactly one task argument — quote it: opsman start \"<task>\""
    fi
    need_cmd jq
    need_cmd git
    "$SCRIPT_DIR/build-registry.sh"
    "$SCRIPT_DIR/init-run.sh" "$1"
    ;;
  next)
    need_cmd jq
    run=$(current_run)
    run_dir=$OPSMAN_RUNS_DIR/$run
    # Reconcile a crash-torn state before deciding which role acts: the
    # journal wins, same rule the mutator applies.
    "$SCRIPT_DIR/acquire-lock.sh"
    trap '"$SCRIPT_DIR/release-lock.sh"' EXIT
    sync_state_with_log "$run_dir"
    state=$(current_status "$run_dir")
    if [ "$state" = "UNDERSTANDING" ] || [ "$state" = "SELECTING" ]; then
      # SELECTING also rescaffolds a lost problem.yaml (recovery path).
      [ -f "$run_dir/problem.yaml" ] || "$SCRIPT_DIR/classify.sh" --run "$run"
    fi
    if [ "$state" = "SELECTING" ] && [ ! -f "$run_dir/candidates.json" ]; then
      "$SCRIPT_DIR/select-skills.sh" --run "$run"
    fi
    "$SCRIPT_DIR/render-context.sh" --run "$run"
    ;;
  status)
    run=$(current_run)
    cat "$OPSMAN_RUNS_DIR/$run/STATE.md"
    ;;
  record)
    run=$(current_run)
    "$SCRIPT_DIR/record-event.sh" --run "$run" "$@"
    ;;
  map)
    "$SCRIPT_DIR/build-registry.sh"
    ;;
  validate-run)
    run=${1:-$(current_run)}
    "$SCRIPT_DIR/validate-artifacts.sh" "$OPSMAN_RUNS_DIR/$run"
    ;;
  validate | judge | resume | clean)
    die "$EX_USAGE" "verb '$verb' is not implemented yet (arrives in a later milestone)"
    ;;
  -h | --help)
    usage
    ;;
  *)
    usage
    exit "$EX_USAGE"
    ;;
esac
